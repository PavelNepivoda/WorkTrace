@model IEnumerable<WorkTrace.Models.Branch>
@{
    ViewData["Title"] = "Pobočky";
}
<h1>Pobočky</h1>
<p><a asp-action="Create" class="btn btn-primary">Nová pobočka</a></p>
<table class="table table-striped">
    <thead>
        <tr><th>Název</th><th>Adresa</th><th>Akce</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Upravit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detaily</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Smazat</a>
                </td>
            </tr>
        }
    </tbody>
</table>