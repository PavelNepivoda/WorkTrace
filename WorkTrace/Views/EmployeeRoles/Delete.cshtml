@model EmployeeRole
@{
    ViewData["Title"] = "Smazat roli";
}

<h1>Smazat roli</h1>

<h3>Opravdu chcete tuto roli smazat?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Název</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Popis</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Smazat" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
    </form>
</div>