@model WorkTrace.Models.Employee
@{
    ViewData["Title"] = "Smazat zaměstnance";
}

<h1>Smazat zaměstnance</h1>

<h3>Opravdu chcete tohoto zaměstnance smazat?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Jméno</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Příjmení</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Telefon</dt>
        <dd class="col-sm-10">@Model.Phone</dd>

        <dt class="col-sm-2">PIN kód</dt>
        <dd class="col-sm-10">@Model.PINCode</dd>

        <dt class="col-sm-2">Pobočka</dt>
        <dd class="col-sm-10">@(Model.Branch?.Name ?? "-")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Smazat" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
    </form>
</div>