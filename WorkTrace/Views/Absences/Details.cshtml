@model Absence
@{
    ViewData["Title"] = "Detaily absence";
}

<h1>Detaily žádosti o absenci</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Zaměstnanec</dt>
        <dd class="col-sm-10">@Model.Employee?.FullName</dd>

        <dt class="col-sm-2">Typ absence</dt>
        <dd class="col-sm-10">@Model.AbsenceType?.Name</dd>

        <dt class="col-sm-2">Od</dt>
        <dd class="col-sm-10">@Model.StartDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Do</dt>
        <dd class="col-sm-10">@Model.EndDate.ToShortDateString()</dd>

        <dt class="col-sm-2">Důvod</dt>
        <dd class="col-sm-10">@Model.Reason</dd>

        <dt class="col-sm-2">Stav</dt>
        <dd class="col-sm-10">
            @if (Model.Status == AbsenceStatus.Pending)
            {
                <span class="badge bg-warning">Čeká na schválení</span>
            }
            else if (Model.Status == AbsenceStatus.Approved)
            {
                <span class="badge bg-success">Schváleno</span>
            }
            else
            {
                <span class="badge bg-danger">Zamítnuto</span>
            }
        </dd>

        <dt class="col-sm-2">Žádost podána</dt>
        <dd class="col-sm-10">@Model.RequestedDate.ToShortDateString()</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Upravit</a>
    <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
</div>