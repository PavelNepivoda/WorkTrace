@model WorkTrace.Models.AbsenceType
@{
    ViewData["Title"] = "Detaily typu absence";
}
<h1>Detaily typu absence</h1>
<div>
    <dl class="row">
        <dt class="col-sm-2">Název</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Popisek</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Upravit</a>
    <a asp-action="Index" class="btn btn-secondary">Zpět na seznam</a>
</div>