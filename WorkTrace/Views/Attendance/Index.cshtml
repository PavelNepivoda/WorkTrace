@model WorkTrace.Models.ViewModel.AttendanceEntryVM

@{
    ViewData["Title"] = "Docházka";
}

<h1>Záznam docházky</h1>

<form asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="PINCode"></label>
                <input asp-for="PINCode" class="form-control" />
                <span asp-validation-for="PINCode" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3 align-self-end">
            <button type="submit" name="action" value="CheckPIN" class="btn btn-primary">Ověřit PIN</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.EmployeeName))
    {
        <div class="alert alert-info mt-3">
            Přihlášen: <strong>@Model.EmployeeName</strong>
            <span class="badge bg-success text-dark">Dnešní záznam</span>
        </div>

        <div class="row mt-3">
            <div class="col-md-3 mb-2">
                <button type="submit" name="action" value="StartWork" class="btn btn-primary w-100"
                        disabled="@(Model.StartWork != null)">
                    Začátek práce
                </button>
                @if (Model.StartWork.HasValue)
                {
                    <div class="text-center mt-1">@Model.StartWork.Value.ToString("HH:mm:ss")</div>
                }
            </div>
            <div class="col-md-3 mb-2">
                <button type="submit" name="action" value="StartBreak" class="btn btn-warning w-100"
                        disabled="@(Model.StartWork == null || (Model.StartBreak != null && Model.EndBreak == null) || Model.EndWork != null)">
                    Začátek přestávky
                </button>
                @if (Model.StartBreak.HasValue)
                {
                    <div class="text-center mt-1">@Model.StartBreak.Value.ToString("HH:mm:ss")</div>
                }
            </div>
            <div class="col-md-3 mb-2">
                <button type="submit" name="action" value="EndBreak" class="btn btn-warning w-100"
                        disabled="@(Model.StartBreak == null || Model.EndBreak != null || Model.EndWork != null)">
                    Konec přestávky
                </button>
                @if (Model.EndBreak.HasValue)
                {
                    <div class="text-center mt-1">@Model.EndBreak.Value.ToString("HH:mm:ss")</div>
                }
            </div>
            <div class="col-md-3 mb-2">
                <button type="submit" name="action" value="EndWork" class="btn btn-danger w-100"
                        disabled="@(Model.StartWork == null || Model.EndWork != null)">
                    Konec práce
                </button>
                @if (Model.EndWork.HasValue)
                {
                    <div class="text-center mt-1">@Model.EndWork.Value.ToString("HH:mm:ss")</div>
                }
            </div>
        </div>
    }
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}