@model PerformanceViewModel
@{
    ViewData["Title"] = "Výkon zaměstnance";
}
<h1>Výkon zaměstnance</h1>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <label>Zaměstnanec</label>
        <select name="employeeId" class="form-control" asp-items="ViewBag.Employees">
            <option value="">-- Vyberte zaměstnance --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label>Od</label>
        <input type="date" name="from" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label>Do</label>
        <input type="date" name="to" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary">Zobrazit</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model.Employee != null)
{
    <hr />
    <h3>@Model.Employee.FullName</h3>
    <p>Období: @Model.StartDate.ToShortDateString() – @Model.EndDate.ToShortDateString()</p>
    <p>Odpracované hodiny: @Model.TotalHours.ToString("F2") h</p>
    <p>Hodinová mzda: @Model.HourlyWage.ToString("C")</p>
    <p>Celková mzda: @Model.TotalWage.ToString("C")</p>

    <table class="table">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Příchod</th>
                <th>Odchod</th>
                <th>Přestávka</th>
                <th>Odprac. hod. (zaokr.)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.AttendanceRecords)
            {
                var rounded = r.GetRoundedWorkHours();
                <tr>
                    <td>@r.Date.ToShortDateString()</td>
                    <td>@(r.StartTime?.ToShortTimeString() ?? "-")</td>
                    <td>@(r.EndTime?.ToShortTimeString() ?? "-")</td>
                    <td>@(r.BreakStart?.ToShortTimeString()) – @(r.BreakEnd?.ToShortTimeString())</td>
                    <td>@rounded.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Vyberte zaměstnance a období pro zobrazení výkonu.</p>
}