@{
    ViewData["Title"] = "Docházkový systém";
}

<div class="container">
    <h1 class="display-4 text-center">Docházkový systém</h1>
    <div class="row mt-4">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5>Záznam docházky</h5>
                </div>
                <div class="card-body">
                    <form method="post" id="pinForm">
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" name="pin" placeholder="Zadejte 4místný PIN" maxlength="4" required>
                            <button type="submit" class="btn btn-success" formaction="@Url.Action("StartWork")">Zahájit práci</button>
                            <button type="submit" class="btn btn-warning" formaction="@Url.Action("StartBreak")">Začít přestávku</button>
                            <button type="submit" class="btn btn-warning" formaction="@Url.Action("EndBreak")">Ukončit přestávku</button>
                            <button type="submit" class="btn btn-danger" formaction="@Url.Action("EndWork")">Ukončit práci</button>
                        </div>
                    </form>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header bg-secondary text-white">
                    <h5>Žádost o absenci</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="RequestAbsence">
                        <div class="form-group mb-3">
                            <label>PIN kód</label>
                            <input type="text" name="pin" class="form-control" maxlength="4" required>
                        </div>
                        <div class="form-group mb-3">
                            <label>Typ absence</label>
                            <select name="absenceTypeId" class="form-control" asp-items="ViewBag.AbsenceTypes" required></select>
                        </div>
                        <div class="form-group mb-3">
                            <label>Datum začátku</label>
                            <input type="date" name="startDate" class="form-control" required>
                        </div>
                        <div class="form-group mb-3">
                            <label>Datum konce</label>
                            <input type="date" name="endDate" class="form-control" required>
                        </div>
                        <div class="form-group mb-3">
                            <label>Důvod (nepovinný)</label>
                            <textarea name="reason" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Odeslat žádost</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function(e) {
                var pinInput = this.querySelector('input[name="pin"]');
                if (pinInput && pinInput.value.length !== 4) {
                    alert('PIN musí mít přesně 4 znaky.');
                    e.preventDefault();
                }
            });
        });
    </script>
}