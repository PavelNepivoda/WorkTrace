@model IEnumerable<WorkTrace.Models.ViewModel.WorkHoursReportVM>
@{
    ViewData["Title"] = "Přehled odpracovaných hodin";
}

<h1>Přehled odpracovaných hodin</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label>Zaměstnanec</label>
        <select name="employeeId" class="form-control" asp-items="ViewBag.Employees">
            <option value="">-- Všichni --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label>Od data</label>
        <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-3">
        <label>Do data</label>
        <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary w-100">Filtrovat</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Datum</th>
            <th>Zaměstnanec</th>
            <th>Začátek práce</th>
            <th>Konec práce</th>
            <th>Přestávka (od-do)</th>
            <th>Délka přestávky</th>
            <th>Odpracováno</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.EmployeeName</td>
                <td>@(item.StartWork ?? "-")</td>
                <td>@(item.EndWork ?? "-")</td>
                <td>@(item.BreakStart != null && item.BreakEnd != null ? $"{item.BreakStart} - {item.BreakEnd}" : "-")</td>
                <td>@item.BreakDuration</td>
                <td>@item.WorkedHoursFormatted</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center">Žádné záznamy neodpovídají zadaným filtrům.</td>
            </tr>
        }
    </tbody>
</table>

@* Souhrn pro celkový přehled *@
@if (Model.Any())
{
    var totalHours = TimeSpan.Zero;
    var totalWorkedMinutes = Model
        .Where(x => x.WorkedHours.HasValue)
        .Sum(x => x.WorkedHours.Value.TotalMinutes);
    totalHours = TimeSpan.FromMinutes(totalWorkedMinutes);

    <div class="alert alert-info">
        <strong>Celkový součet odpracovaných hodin:</strong> @totalHours.ToString(@"hh\:mm")
    </div>
}