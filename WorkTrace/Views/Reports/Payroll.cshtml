@model IEnumerable<WorkTrace.Models.ViewModel.PayrollReportVM>
@{
    ViewData["Title"] = "Mzdový přehled";
}

<h1>Mzdový přehled</h1>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label>Zaměstnanec</label>
        <select name="employeeId" class="form-control" asp-items="ViewBag.Employees">
            <option value="">-- Všichni --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label>Od data</label>
        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
    </div>
    <div class="col-md-3">
        <label>Do data</label>
        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
    </div>
    <div class="col-md-2 align-self-end">
        <button type="submit" class="btn btn-primary w-100">Filtrovat</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Datum</th>
            <th>Zaměstnanec</th>
            <th>Odpracováno</th>
            <th>Hodinová mzda</th>
            <th>Celkem</th>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.EmployeeName</td>
                <td>@item.WorkedHoursFormatted</td>
                <td>@item.HourlyWage.ToString("C")</td>
                <td>@item.TotalPayFormatted</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">Žádné záznamy neodpovídají zadaným filtrům.</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Any())
{
    var totalPaySum = Model.Sum(x => x.TotalPay);
    var totalHours = TimeSpan.FromMinutes(Model.Where(x => x.WorkedHours.HasValue).Sum(x => x.WorkedHours.Value.TotalMinutes));
    <div class="alert alert-info">
        <strong>Celkový součet:</strong> @totalHours.ToString(@"hh\:mm") hodin, celková odměna @totalPaySum.ToString("C")
    </div>
}